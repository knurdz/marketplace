APP_NAME="Knurdz Storage API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://marketplace-storage.knurdz.org

LOG_CHANNEL=single
LOG_LEVEL=error
FILESYSTEM_DISK=local
CACHE_STORE=file
SESSION_DRIVER=array

# Shared bearer token verified against Next.js server uploads/deletes.
# Generate a strong secret (e.g. `openssl rand -base64 32`) and set the same value
# in Vercel's STORAGE_API_TOKEN environment variable.
STORAGE_API_TOKEN=
