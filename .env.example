# Public app origin for this environment (OAuth, email links, PayHere return URLs)
# Local: http://localhost:3000  |  Production: https://marketplace.knurdz.org
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OAuth allowlist — both local + production so Google/GitHub redirect URIs work anywhere
AUTH_LOCAL_APP_URL=http://localhost:3000
AUTH_PRODUCTION_APP_URL=https://marketplace.knurdz.org
# Optional comma-separated extras (previews, tunnels):
# AUTH_TRUSTED_ORIGINS=https://preview.example.com

# MariaDB (docker compose defaults)
DATABASE_URL=mysql://knurdz:knurdz_dev@127.0.0.1:3306/marketplace

# Better Auth session signing secret (server only; required in production)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# SMTP for email verification + password reset (server only — never NEXT_PUBLIC_*)
# Hostinger example: smtp.hostinger.com, port 465 (SSL) or 587
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=
# SMTP_FROM="Knurdz Marketplace <noreply@yourdomain.com>"

# Better Auth — optional OAuth (leave empty to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# PayHere (server only — never NEXT_PUBLIC_*)
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true
# APP_URL=http://localhost:3000
# PAYHERE_NOTIFY_URL=https://your-tunnel.example/api/payhere/notify

# File storage (Hostinger storage-api for production; local ./uploads fallback when unset)
# STORAGE_API_URL=https://marketplace-storage.knurdz.org
# STORAGE_API_TOKEN=
# NEXT_PUBLIC_STORAGE_URL=https://marketplace-storage.knurdz.org
# Local fallback serves files at /api/files/{bucket}/{fileId}
