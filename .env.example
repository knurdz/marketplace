# Public client config only — endpoint, project id, and app URL may be NEXT_PUBLIC_*.
# Never put API keys or merchant secrets in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=

# Server / Function only — never NEXT_PUBLIC:
APPWRITE_API_KEY=
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
