# Public client config only — endpoint, project id, and app URL may be NEXT_PUBLIC_*.
# Never put API keys or merchant secrets in NEXT_PUBLIC_* vars.
#
# Example (Knurdz Marketplace / sgp):
#   NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
#   NEXT_PUBLIC_APPWRITE_PROJECT_ID=<from Appwrite Console → Settings>
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APP_URL=

# Server / Function only — never NEXT_PUBLIC:
# API key needs sessions.write for SSR auth, plus users.write and
# databases.write (or TablesDB equivalent) for profile create-on-register (1.5+).
# Storage write for scripts/setup-storage-buckets.mjs (1.8+).
# users.write + TablesDB write also required for npm run seed (1.12).
APPWRITE_API_KEY=

# TablesDB IDs are code constants in lib/appwrite/config.ts (must match console / docs/agent/SCHEMA.md):
#   DATABASE_ID=marketplace
#   tables: profiles, seller_profiles, categories, products, … (see SCHEMA.md)
# Storage buckets: avatars, product-images, bank-slips (see SCHEMA.md)

# PayHere (docs/agent/PAYHERE.md):
# Put these on the Appwrite Function `payhere-checkout-hash` (and later `payhere-notify`).
# Do NOT put PAYHERE_MERCHANT_SECRET in NEXT_PUBLIC_* or import it in the Next app.
# Next calls the hash Function via requestPayHereCheckout — it never hashes locally.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_SANDBOX=true            # unset/true = sandbox; false/live = 501 until merchant authorization
# APP_URL=                    # Function env: public origin (same as NEXT_PUBLIC_APP_URL)
# PAYHERE_NOTIFY_URL=         # Function env: public payhere-notify URL (step 1.23)
